  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@plone/blocks": "1.0.0-alpha.11",
    "@plone/cmsui": "1.0.0-alpha.4",
    "@plone/components": "5.0.0-alpha.1",
    "@plone/helpers": "2.0.0-alpha.7",
    "@plone/layout": "1.0.0-alpha.9",
    "@plone/plate": "1.0.0-alpha.9",
    "@plone/registry": "4.0.0-alpha.1",
    "@plone/theming": "1.0.0-alpha.6",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.6.2",
    "prettier-plugin-css-order": "^2.1.2",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-organize-imports": "^4.2.0",
    "react": "^19.3.0",
